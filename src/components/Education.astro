---
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{hasEducation && (
  <section
    id="education"
    class="relative bg-transparent px-6 sm:px-10 md:px-16 lg:px-24 py-28"
  >

    <!-- glow background -->
    <div class="absolute inset-0 -z-10">
      <div
        class="absolute bottom-10 left-10 h-[32rem] w-[32rem] rounded-full blur-3xl opacity-25"
        style="background: rgba(245, 158, 11, 0.10)"
      />
    </div>

    <div class="max-w-6xl mx-auto">

      <!-- HEADER -->
      <div class="mb-16">
        <h2 class="font-syne text-5xl md:text-6xl font-bold">
          Education
        </h2>

        <div class="w-16 h-[2px] mt-5 rounded-full bg-[rgba(245,158,11,0.6)]" />
      </div>

      <!-- TIMELINE -->
      <div class="relative border-l border-white/10 pl-6 sm:pl-8 space-y-10">

        {siteConfig.education.map((edu) => (
          <div class="relative">

            <!-- node -->
            <div class="absolute -left-[26px] sm:-left-[41px] top-2 w-3 h-3 rounded-full bg-[rgba(245,158,11,0.7)] shadow-[0_0_18px_rgba(245,158,11,0.35)]" />

            <!-- card -->
            <div class="p-6 sm:p-8 rounded-2xl border border-white/10 bg-white/5 backdrop-blur
                        transition-all duration-300 hover:bg-white/[0.07] hover:border-white/20">

              <!-- header -->
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 md:gap-4">

                <div>
                  <h3 class="font-syne text-xl sm:text-2xl md:text-3xl font-semibold text-white">
                    {edu.degree}
                  </h3>

                  <p class="mt-2 text-[rgba(245,158,11,0.85)] font-medium text-sm sm:text-base">
                    {edu.school}
                  </p>
                </div>

                <span class="text-xs sm:text-sm text-[rgba(245,158,11,0.85)] font-mono tracking-wide whitespace-nowrap">
                  {edu.dateRange}
                </span>

              </div>

              <!-- achievements -->
              <ul class="mt-5 sm:mt-6 space-y-2 sm:space-y-3 text-white/60 text-sm sm:text-base">
                {edu.achievements.map((achievement) => (
                  <li class="flex gap-3">
                    <span class="mt-2 w-1.5 h-1.5 rounded-full bg-white/30 flex-shrink-0" />
                    <span>{achievement}</span>
                  </li>
                ))}
              </ul>

            </div>
          </div>
        ))}

      </div>
    </div>
  </section>
)}