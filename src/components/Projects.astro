---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{hasProjects && (
  <section
    id="projects"
    class="relative bg-transparent px-6 sm:px-10 md:px-16 lg:px-24 py-10"
  >

    <!-- glow -->
    <div class="absolute inset-0 -z-10">
      <div
        class="absolute top-20 left-10 h-[30rem] w-[30rem] rounded-full blur-3xl opacity-30"
        style="background: rgba(245, 158, 11, 0.10)"
      />
    </div>

    <div class="max-w-6xl mx-auto">

      <!-- HEADER -->
      <div class="mb-16">
        <h2 class="font-syne text-5xl md:text-6xl font-bold">
          Projects
        </h2>
        <div class="w-16 h-[2px] mt-5 rounded-full bg-[rgba(245,158,11,0.6)]"></div>
      </div>

      <!-- PROJECTS -->
      <div class="space-y-10">

        {siteConfig.projects.map((project, index) => {
          const Component = project.link ? "a" : "div";

          return (
            <Component
              href={project.link}
              rel={project.link ? "noopener noreferrer" : undefined}
              class="group block"
            >

              <div class="relative p-8 rounded-2xl border border-white/10 bg-white/5 backdrop-blur
                          transition hover:bg-white/[0.07] hover:border-white/20">

                <div class="grid grid-cols-12 gap-8 items-start">

                  <div class="col-span-1">
                    <span class="text-sm font-mono text-[rgba(245,158,11,0.8)]">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                  </div>

                  <div class="col-span-7 space-y-4">

                    {/* TITLE */}
                    <h3 class="font-syne text-2xl md:text-3xl font-semibold text-white leading-tight">
                      {project.name}
                    </h3>

                    {/* DESCRIPTION */}
                    <p class="text-white/60 leading-relaxed max-w-2xl">
                      {project.description}
                    </p>

                    {/* SKILLS */}
                    {project.skills && (
                      <div class="flex flex-wrap gap-2">
                        {project.skills.map((skill) => (
                          <span class="px-3 py-1 rounded-full border border-white/10 bg-white/5 text-xs text-white/60">
                            {skill}
                          </span>
                        ))}
                      </div>
                    )}

                    {/* VIEW */}
                    {project.link && (
                      <div class="text-[rgba(245,158,11,0.8)] text-sm tracking-widest uppercase opacity-70 group-hover:opacity-100 transition">
                        View →
                      </div>
                    )}

                  </div>

                  {/* IMAGE */}
                  <div class="col-span-4">
                    <div class="relative aspect-[4/2] rounded-xl overflow-hidden border border-white/10 bg-white/5">

                      <img
                        src={project.image || "/images/project-placeholder.jpg"}
                        alt={project.name}
                        class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105"
                      />

                      <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
                      <div class="absolute inset-0 ring-1 ring-inset ring-[rgba(245,158,11,0.08)]"></div>

                    </div>
                  </div>

                </div>

                <div class="absolute bottom-0 left-0 h-[1px] w-0 group-hover:w-full transition-all duration-500 bg-[rgba(245,158,11,0.5)]"></div>

              </div>

            </Component>
          );
        })}

      </div>
    </div>
  </section>
)}