---
import { siteConfig } from "../config";
---

<section
  id="about"
  class="relative overflow-hidden bg-transparent px-4 sm:px-6 md:px-16 lg:px-24 py-16"
>
  <!-- BACKGROUND -->
  <div class="absolute inset-0 -z-10">
    <div
      class="absolute top-24 right-1/2 translate-x-1/2 sm:right-10 sm:translate-x-0
             h-[22rem] w-[22rem] sm:h-[30rem] sm:w-[30rem]
             rounded-full blur-3xl opacity-30"
      style="background: rgba(245, 158, 11, 0.12)"
    >
    </div>

    <div
      class="absolute bottom-10 left-1/2 -translate-x-1/2 sm:left-10 sm:translate-x-0
             h-[24rem] w-[24rem] sm:h-[32rem] sm:w-[32rem]
             rounded-full blur-3xl opacity-20"
      style="background: rgba(255, 255, 255, 0.05)"
    >
    </div>
  </div>

  <div class="max-w-6xl mx-auto space-y-12 sm:space-y-16">
    <!-- TITLE -->
    <div>
      <h2
        class="font-syne text-4xl sm:text-5xl md:text-6xl font-bold text-white"
      >
        About Me
      </h2>

      <div
        class="w-20 sm:w-24 h-[2px] mt-4 sm:mt-5 rounded-full
               bg-[rgba(245,158,11,0.7)]
               shadow-[0_0_25px_rgba(245,158,11,0.25)]"
      >
      </div>
    </div>

    <!-- CONTENT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <!-- IMAGE -->
      <div class="lg:col-span-4 flex justify-center lg:justify-start">
        <div class="relative w-full max-w-xs sm:max-w-sm">
          <!-- glow frame -->
          <div
            class="absolute inset-3 sm:inset-4 rounded-[2rem] rotate-3 sm:rotate-6
                   border border-white/10 bg-white/5 backdrop-blur-xl"
          >
          </div>

          <div
            class="relative aspect-[4/5] overflow-hidden rounded-[2rem]
                   border border-white/10 bg-white/5 shadow-2xl"
          >
            <img
              src="/images/photo.jpeg"
              alt="Profile picture"
              class="w-full h-full object-cover"
            />

            <div
              class="absolute inset-0 ring-1 ring-inset
                     ring-[rgba(245,158,11,0.08)]"
            >
            </div>
          </div>
        </div>
      </div>

      <!-- TEXT -->
      <div class="lg:col-span-8 space-y-10">
        <p
          class="text-base sm:text-lg md:text-xl text-white/75 leading-relaxed"
        >
          <span set:html={siteConfig.aboutMe} />
        </p>

        <!-- SKILLS GRID -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
          <!-- SKILL BLOCK -->
          {
            [
              ["Languages", siteConfig.skills.languages],
              ["Frontend", siteConfig.skills.frontend],
              ["Backend", siteConfig.skills.backend],
              ["Mobile", siteConfig.skills.mobile],
              ["Workflow", siteConfig.skills.tools],
            ].map(([title, list]) => (
              <div
                class="p-4 sm:p-5 rounded-xl border border-white/10 
                     bg-white/5 backdrop-blur-xl"
              >
                <h3
                  class="text-xs sm:text-sm uppercase tracking-[0.2em] 
                       text-[rgba(245,158,11,0.80)] mb-3"
                >
                  {title}
                </h3>

                <div class="flex flex-wrap gap-2">
                  {list.map((skill) => (
                    <span
                      class="px-2 sm:px-3 py-1 rounded-full text-[10px] sm:text-xs
                           bg-black/20 border border-white/10 text-white/70
                           hover:border-[rgba(245,158,11,0.4)] hover:text-white transition"
                    >
                      {skill}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
