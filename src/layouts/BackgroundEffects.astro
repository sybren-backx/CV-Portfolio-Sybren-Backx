<div class="fixed inset-0 -z-10 pointer-events-none overflow-hidden">
  <canvas id="global-particles"></canvas>

  <!-- glow layer -->
  <div class="absolute inset-0">
    <div
      class="absolute top-24 left-10 h-[20rem] sm:h-[28rem] lg:h-[32rem]
             w-[20rem] sm:w-[28rem] lg:w-[32rem]
             rounded-full blur-3xl opacity-25 bg-orange-500/10"
    >
    </div>

    <div
      class="absolute bottom-10 right-10 h-[22rem] sm:h-[30rem] lg:h-[34rem]
             w-[22rem] sm:w-[30rem] lg:w-[34rem]
             rounded-full blur-3xl opacity-20 bg-white/5"
    >
    </div>
  </div>
</div>

<script is:inline>
  const canvas = document.getElementById("global-particles");
  const ctx = canvas.getContext("2d");

  let particles = [];
  const PARTICLE_COUNT = window.innerWidth < 768 ? 25 : 60;
  const CONNECTION_DISTANCE = window.innerWidth < 768 ? 90 : 140;

  function resize() {
    const dpr = window.devicePixelRatio || 1;

    canvas.width = window.innerWidth * dpr;
    canvas.height = window.innerHeight * dpr;

    canvas.style.width = window.innerWidth + "px";
    canvas.style.height = window.innerHeight + "px";

    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  window.addEventListener("resize", resize);
  resize();

  function init() {
    particles = Array.from({ length: PARTICLE_COUNT }, () => ({
      x: Math.random() * window.innerWidth,
      y: Math.random() * window.innerHeight,

      vx: (Math.random() - 0.5) * 0.25,
      vy: (Math.random() - 0.5) * 0.25,

      r: Math.random() * 2 + 1,
    }));
  }

  function drawConnections() {
    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const a = particles[i];
        const b = particles[j];

        const dx = a.x - b.x;
        const dy = a.y - b.y;
        const dist = Math.sqrt(dx * dx + dy * dy);

        if (dist < CONNECTION_DISTANCE) {
          const alpha = 1 - dist / CONNECTION_DISTANCE;

          ctx.beginPath();
          ctx.strokeStyle = `rgba(245, 158, 11, ${alpha * 0.2})`;
          ctx.lineWidth = 1;
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }
    }
  }

  function drawParticles() {
    for (let p of particles) {
      p.x += p.vx;
      p.y += p.vy;

      if (p.x < -10) p.x = window.innerWidth + 10;
      if (p.x > window.innerWidth + 10) p.x = -10;
      if (p.y < -10) p.y = window.innerHeight + 10;
      if (p.y > window.innerHeight + 10) p.y = -10;

      ctx.beginPath();
      ctx.fillStyle = "rgba(245, 158, 11, 0.5)";
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  function animate() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    drawConnections();
    drawParticles();

    requestAnimationFrame(animate);
  }

  init();
  animate();
</script>
